{
  "name": "qa-automation-assignment",
  "version": "1.0.0",
  "description": "Production-grade Playwright TypeScript automation framework — UI + API",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium tests/ui",
    "test:api": "playwright test --project=api tests/api",
    "test:parallel": "playwright test --workers=4",
    "test:headed": "playwright test --headed --workers=1",
    "report": "playwright show-report playwright-report",
    "report:allure": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "report:allure:ci": "allure generate allure-results -o allure-report --clean",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "allure-commandline": "^2.42.0",
    "allure-js-commons": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.2.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "playwright": "1.60"
  }
}
