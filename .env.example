# ── Web Target ──────────────────────────────────────────────────────────────
WEB_BASE_URL=https://www.saucedemo.com
STANDARD_USER=standard_user
STANDARD_PASSWORD=secret_sauce
LOCKED_USER=locked_out_user

# ── API Target ───────────────────────────────────────────────────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com

# ── Health service (only needed for health tests — start with ./run.sh api) ──
HEALTH_API_URL=http://localhost:8000
GRAFANA_URL=http://localhost:3000
ALLURE_REPORT_URL=https://amielnoy.github.io/ModelioAutomationTest/

# ── Playwright ────────────────────────────────────────────────────────────────
# Browser: chromium | firefox | webkit
BROWSER=chromium
# Parallelism (default 4 for CI, 1 for --headed local)
WORKERS=4
# Timeout in ms
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
