{
  "title": "QA System Health",
  "uid": "qa-health",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "tags": ["qa", "automation"],
  "panels": [

    { "id": 100, "title": "Test Results", "type": "row", "collapsed": false, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },

    {
      "id": 1,
      "title": "Total Tests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_total[3h])", "legendFormat": "Total" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 2,
      "title": "Passed",
      "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_passed[3h])", "legendFormat": "Passed" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 3,
      "title": "Failed",
      "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_failed[3h])", "legendFormat": "Failed" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 4,
      "title": "Flaky",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_flaky[3h])", "legendFormat": "Flaky" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 5,
      "title": "Skipped",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_skipped[3h])", "legendFormat": "Skipped" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "gray" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "gray", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 6,
      "title": "Last Run Duration",
      "type": "stat",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [{ "expr": "last_over_time(qa_tests_duration_seconds[3h])", "legendFormat": "Duration" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 7,
      "title": "Test Run History",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "targets": [
        { "expr": "qa_tests_passed",  "legendFormat": "Passed" },
        { "expr": "qa_tests_failed",  "legendFormat": "Failed" },
        { "expr": "qa_tests_flaky",   "legendFormat": "Flaky" },
        { "expr": "qa_tests_skipped", "legendFormat": "Skipped" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Passed" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "Failed" },  "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Flaky" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Skipped" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 101, "title": "Service Status", "type": "row", "collapsed": false, "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 } },

    {
      "id": 10,
      "title": "SauceDemo UI",
      "type": "stat",
      "gridPos": { "x": 0, "y": 14, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_service_up{service=\"web_ui\"}", "legendFormat": "web_ui" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 11,
      "title": "JSONPlaceholder API",
      "type": "stat",
      "gridPos": { "x": 6, "y": 14, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_service_up{service=\"json_api\"}", "legendFormat": "json_api" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 12,
      "title": "Prometheus",
      "type": "stat",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_service_up{service=\"prometheus\"}", "legendFormat": "prometheus" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 13,
      "title": "Grafana",
      "type": "stat",
      "gridPos": { "x": 18, "y": 14, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_service_up{service=\"grafana\"}", "legendFormat": "grafana" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "OK", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 14,
      "title": "Service Latency (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 7 },
      "targets": [
        { "expr": "qa_service_latency_ms{service=\"web_ui\"}",    "legendFormat": "SauceDemo UI" },
        { "expr": "qa_service_latency_ms{service=\"json_api\"}",  "legendFormat": "JSONPlaceholder" },
        { "expr": "qa_service_latency_ms{service=\"prometheus\"}", "legendFormat": "Prometheus" },
        { "expr": "qa_service_latency_ms{service=\"grafana\"}",   "legendFormat": "Grafana" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 15,
      "title": "HTTP Status Codes",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 7 },
      "targets": [
        { "expr": "qa_service_http_code{service=\"web_ui\"}",    "legendFormat": "SauceDemo UI" },
        { "expr": "qa_service_http_code{service=\"json_api\"}",  "legendFormat": "JSONPlaceholder" },
        { "expr": "qa_service_http_code{service=\"prometheus\"}", "legendFormat": "Prometheus" },
        { "expr": "qa_service_http_code{service=\"grafana\"}",   "legendFormat": "Grafana" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    { "id": 102, "title": "Infrastructure", "type": "row", "collapsed": false, "gridPos": { "x": 0, "y": 25, "w": 24, "h": 1 } },

    {
      "id": 20,
      "title": "Error Rate (5xx)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 26, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"health-api\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"health-api\"}[5m]))",
          "legendFormat": "error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 21,
      "title": "Health API Uptime",
      "type": "stat",
      "gridPos": { "x": 6, "y": 26, "w": 6, "h": 4 },
      "targets": [{ "expr": "process_start_time_seconds{job=\"health-api\"}", "legendFormat": "uptime" }],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 22,
      "title": "Disk Used",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 26, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_disk_used_bytes / qa_disk_total_bytes", "legendFormat": "Disk Used %" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": false, "showThresholdMarkers": true }
    },

    {
      "id": 23,
      "title": "Disk Free",
      "type": "stat",
      "gridPos": { "x": 18, "y": 26, "w": 6, "h": 4 },
      "targets": [{ "expr": "qa_disk_free_bytes", "legendFormat": "Free" }],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1073741824 }, { "color": "green", "value": 5368709120 }] }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "auto", "colorMode": "background" }
    },

    {
      "id": 24,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "rate(http_requests_total{job=\"health-api\"}[1m])",
          "legendFormat": "{{method}} {{handler}} {{status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },

    {
      "id": 25,
      "title": "Request Latency p95 (s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"health-api\"}[1m]))",
          "legendFormat": "p95 {{handler}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }

  ]
}
